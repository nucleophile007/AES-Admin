{
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "build": {
    "env": {
      "PRISMA_GENERATE_DATAPROXY": "false",
      "PRISMA_CLI_QUERY_ENGINE_TYPE": "binary",
      "PRISMA_CLIENT_ENGINE_TYPE": "binary",
      "PRISMA_QUERY_ENGINE_BINARY": "rhel-openssl-3.0.x",
      "PRISMA_DISABLE_DATAPROXY": "true"
    }
  },
  "env": {
    "PRISMA_GENERATE_DATAPROXY": "false",
    "PRISMA_CLI_QUERY_ENGINE_TYPE": "binary", 
    "PRISMA_CLIENT_ENGINE_TYPE": "binary",
    "PRISMA_QUERY_ENGINE_BINARY": "rhel-openssl-3.0.x",
    "PRISMA_DISABLE_DATAPROXY": "true"
  }
}
